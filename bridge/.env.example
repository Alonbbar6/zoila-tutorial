# Settings for the Claude Code bridge (node bridge/*.mjs).
#
# 1. Copy this file:   cp bridge/.env.example bridge/.env
# 2. Fill in the two values below. bridge/.env is ignored by git: never commit it.
# Variables set in your shell environment override the values in bridge/.env.

# The Apps Script Web App URL. Find it in Apps Script: Deploy > Manage deployments > Web app URL.
# It looks like https://script.google.com/macros/s/AKfy.../exec (it must end with /exec).
# The value below is the local dev server (node dev/server.mjs).
TUTOR_API_URL=http://localhost:8787/api

# The admin token. setup() prints it in the Apps Script execution log; it is also stored in
# Project Settings > Script Properties > ADMIN_TOKEN. Keep it secret: whoever has it can read
# and answer every conversation.
# The value below only works with the local dev server.
TUTOR_ADMIN_TOKEN=dev-admin-0123456789abcdef0123456789abcdef
